{
  "name": "cinematch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:api": "pnpm --filter @cinematch/api run test",
    "migrate:up": "pnpm --filter @cinematch/api run migrate:up",
    "migrate:down": "pnpm --filter @cinematch/api run migrate:down",
    "migrate:create": "pnpm --filter @cinematch/api run migrate:create",
    "seed": "pnpm --filter @cinematch/api run seed",
    "seed:demo": "pnpm --filter @cinematch/api run seed:demo",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
