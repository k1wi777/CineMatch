# Copia este archivo a apps/api/.env. No lo subas al repositorio.
# Valores pensados para desarrollo local con `docker compose up -d` en la raíz.

NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info

# Aplica las migraciones pendientes al arrancar la API (solo desarrollo local).
MIGRATE_ON_START=false

# Administrador inicial (`pnpm seed`). Define las tres o ninguna; si faltan algunas, el seed falla.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# PostgreSQL (docker-compose.yml). La base de pruebas la usa BE-0.5.
DATABASE_URL=postgres://cinematch:cinematch_local@localhost:5432/cinematch
TEST_DATABASE_URL=postgres://cinematch:cinematch_local@localhost:5432/cinematch_test

# Sesiones (BE-3). Usar un valor distinto y largo en cualquier entorno compartido.
SESSION_SECRET=dev-only-change-me-to-a-long-random-value

# Catálogo externo (BE-6). Se declara aquí, pero no se consume hasta BE-6.
TMDB_API_KEY=

# Correo: Mailpit en desarrollo (interfaz en http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=CineMatch <no-reply@cinematch.local>

# URL pública de la web (enlaces en correos y orígenes permitidos).
WEB_URL=http://localhost:3000
