{
  "name": "@cinematch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "migrate:up": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:down": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "migrate:create": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js create --migration-file-language sql",
    "seed": "tsx --env-file-if-exists=.env seeds/index.ts",
    "seed:demo": "tsx --env-file-if-exists=.env seeds/index.ts --demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@cinematch/shared": "workspace:*",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
